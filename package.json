{
  "name": "rummikube-multiplayer",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer Rummikube web game",
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/game-logic"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm --prefix packages/game-logic run build && npm --prefix packages/backend run build && npx vite build",
    "start": "npm start --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6"
  }
}
